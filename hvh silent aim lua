-- ================= Hook Namecall (Silent Aim) =================
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(Self, ...)
    local Args = {...} local Method = getnamecallmethod()
    if _G.SilentAimEnabled and ClosestTarget and not checkcaller() then
        if (Method == "ScreenPointToRay" or Method == "ViewportPointToRay") and Self == Camera then
            return Ray.new(Camera.CFrame.Position, (ClosestTarget.Position - Camera.CFrame.Position).Unit)
        end
        if Method == "Raycast" and tostring(Self) == "Workspace" then
            local Origin = Args[1]
            if _G.BulletTPEnabled then Args[1] = ClosestTarget.Position - (Args[2].Unit * 1) Args[2] = Args[2].Unit * 5 else Args[2] = (ClosestTarget.Position - Origin).Unit * Args[2].Magnitude end
            return OldNamecall(Self, unpack(Args))
        end
        if (Method == "FindPartOnRay" or Method == "FindPartOnRayWithIgnoreList" or Method == "FindPartOnRayWithWhitelist") and tostring(Self) == "Workspace" then
            local CurrentRay = Args[1]
            if _G.BulletTPEnabled then local NewOrigin = ClosestTarget.Position - (CurrentRay.Direction.Unit * 1) Args[1] = Ray.new(NewOrigin, CurrentRay.Direction.Unit * 5)
            else Args[1] = Ray.new(CurrentRay.Origin, (ClosestTarget.Position - CurrentRay.Origin).Unit * CurrentRay.Direction.Magnitude) end
            return OldNamecall(Self, unpack(Args))
        end
    end
    return OldNamecall(Self, ...)
end))

