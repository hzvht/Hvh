local function getScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function isBehindWall(targetPart)
    if not _G.WallCheckEnabled then return false end
    local Parts = Camera:GetPartsObscuringTarget({targetPart.Position}, {LocalPlayer.Character, targetPart.Parent})
    return #Parts > 0
end

local function isDead(humanoid, char)
    if not _G.DieCheckEnabled then return false end
    if humanoid and humanoid.Health <= 0 then return true end
    if char and not char:IsDescendantOf(workspace) then return true end
    return false
end

-- ================= Taser Beam Creator Function =================
local function CreateTaserBeam(startPos, endPos)
    if not _G.TaserEnabled then return end
    
    local beam = Instance.new("Part")
    beam.Name = "TaserBeamLine"
    beam.Anchored = true
    beam.CanCollide = false
    beam.Material = Enum.Material.Neon
    beam.Color = _G.TaserColor
    
    local distance = (startPos - endPos).Magnitude
    beam.Size = Vector3.new(0.15, 0.15, distance)
    beam.CFrame = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
    beam.Parent = workspace
    
    task.spawn(function()
        for i = 1, 10 do
            task.wait(0.04)
            beam.Transparency = i / 10
        end
        beam:Destroy()
    end)
end

