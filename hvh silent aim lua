-- ================= Target Selector System =================
local ClosestTarget = nil
local CurrentTargetPlayer = nil

task.spawn(function()
    while task.wait(0.1) do
        if not _G.SilentAimEnabled then 
            ClosestTarget = nil 
            CurrentTargetPlayer = nil
        else
            local TempTarget = nil
            local TempPlayer = nil
            local MaxDistance = _G.FOVSize
            local Center = getScreenCenter()
            local MyRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local PotentialTargets = {}

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    table.insert(PotentialTargets, player.Character)
                end
            end

            for _, char in ipairs(PotentialTargets) do
                local targetPart = char:FindFirstChild(_G.AimPart) or char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                if targetPart and humanoid then
                    if isDead(humanoid, char) then continue end
                    if MyRoot and (targetPart.Position - MyRoot.Position).Magnitude > 500 then continue end
                    if isBehindWall(targetPart) then continue end
                    
                    local ScreenPosition, OnScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if OnScreen then
                        local DistanceToCenter = (Vector2.new(ScreenPosition.X, ScreenPosition.Y) - Center).Magnitude
                        if DistanceToCenter < MaxDistance then
                            TempTarget = targetPart
                            TempPlayer = Players:GetPlayerFromCharacter(char)
                            MaxDistance = DistanceToCenter
                        end
                    end
                end
            end
            ClosestTarget = TempTarget
            CurrentTargetPlayer = TempPlayer
        end
    end
end)

