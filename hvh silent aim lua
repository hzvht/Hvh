local RunService = game:GetService("RunService")
local spinAngle = 0
local itemTickCounter = 0
local jitterToggle = false
local LastLoggedHudTargetId = 0

RunService.RenderStepped:Connect(function(deltaTime)
    local Center = getScreenCenter()
    local ShowCircle = _G.FOVVisible and _G.SilentAimEnabled
    
    FOVCircleOutline.Position = Center FOVCircleOutline.Radius = _G.FOVSize FOVCircleOutline.Visible = ShowCircle
    FOVCircle.Position = Center FOVCircle.Radius = _G.FOVSize FOVCircle.Visible = ShowCircle
    
    if _G.SilentAimEnabled and _G.TracerEnabled and ClosestTarget then
        local TargetPos, OnScreen = Camera:WorldToViewportPoint(ClosestTarget.Position)
        if OnScreen then
            local ToPos = Vector2.new(TargetPos.X, TargetPos.Y)
            TracerLineOutline.From = Center TracerLineOutline.To = ToPos TracerLineOutline.Visible = true
            TracerLine.From = Center TracerLine.To = ToPos TracerLine.Visible = true
        else
            TracerLineOutline.Visible = false TracerLine.Visible = false
        end
    else
        TracerLineOutline.Visible = false TracerLine.Visible = false
    end

    -- TARGET HUD UPDATE LOOP
    if _G.SilentAimEnabled and CurrentTargetPlayer and CurrentTargetPlayer.Character then
        local Hum = CurrentTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if Hum and Hum.Health > 0 then
            DisplayNameLabel.Text = CurrentTargetPlayer.DisplayName
            UsernameLabel.Text = "@" .. CurrentTargetPlayer.Name
            UserIdLabel.Text = "ID: " .. tostring(CurrentTargetPlayer.UserId)
            
            local pct = math.clamp(Hum.Health / Hum.MaxHealth, 0, 1)
            HealthBar.Size = UDim2.new(pct, 0, 1, 0)
            HealthBar.BackgroundColor3 = Color3.fromHSV(pct * 0.33, 1, 1)
            
            if CurrentTargetPlayer.UserId ~= LastLoggedHudTargetId then
                LastLoggedHudTargetId = CurrentTargetPlayer.UserId
                AvatarImage.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(CurrentTargetPlayer.UserId) .. "&w=48&h=48"
            end
            
            MainFrame.Visible = true
        else
            MainFrame.Visible = false
            LastLoggedHudTargetId = 0
        end
    else
        MainFrame.Visible = false
        LastLoggedHudTargetId = 0
    end

    -- ANTI AIM CORE
    if _G.AntiAimEnabled and LocalPlayer.Character then
        local Root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if Root and Humanoid and Humanoid.Health > 0 then
            Humanoid.AutoRotate = false
            if _G.AntiAimMode == "Spin" then
                spinAngle = (spinAngle + _G.AntiAimSpeed) % 360
                Root.CFrame = CFrame.new(Root.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
            elseif _G.AntiAimMode == "Jitter" then
                jitterToggle = not jitterToggle
                local _, cameraY, _ = Camera.CFrame:ToOrientation()
                local jitterOffset = jitterToggle and math.rad(120) or math.rad(-120)
                
                Root.CFrame = CFrame.new(Root.Position) * CFrame.Angles(0, cameraY + jitterOffset, 0)
                
                local LowerTorso = LocalPlayer.Character:FindFirstChild("LowerTorso") or LocalPlayer.Character:FindFirstChild("Torso")
                if LowerTorso and LowerTorso:FindFirstChild("RootJoint") then
                    LowerTorso.RootJoint.Transform = CFrame.Angles(0, jitterOffset, 0)
                end
            end
        end
    else
        if LocalPlayer.Character then
            local Humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if Humanoid then Humanoid.AutoRotate = true end
            local LowerTorso = LocalPlayer.Character:FindFirstChild("LowerTorso") or LocalPlayer.Character:FindFirstChild("Torso")
            if LowerTorso and LowerTorso:FindFirstChild("RootJoint") then
                LowerTorso.RootJoint.Transform = CFrame.new()
            end
        end
    end

    if _G.ThirdPersonEnabled and LocalPlayer.Character then
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then obj.LocalTransparencyModifier = 0 end
        end
        local cameraRotation = Camera.CFrame - Camera.CFrame.Position
        local targetCameraPosition = Camera.Focus.Position - (Camera.CFrame.LookVector * _G.ThirdPersonDistance)
        Camera.CFrame = cameraRotation + targetCameraPosition
    end

    -- BILLBOARD HEAD-LOCK ESP RENDERER LOOP
    for player, v in pairs(ESP_Storage) do
        local char = player.Character 
        local head = char and char:FindFirstChild("Head") 
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if _G.ESPEnabled and char and head and hrp and humanoid and humanoid.Health > 0 then
            local highlight = char:FindFirstChild("StaticHighlight")
            if _G.ESPHighlights then
                if not highlight then highlight = Instance.new("Highlight") highlight.Name = "StaticHighlight" highlight.Parent = char end
                highlight.FillColor = _G.ColorBox highlight.FillTransparency = 0.5 highlight.OutlineColor = Color3.fromRGB(0, 0, 0) highlight.OutlineTransparency = 0 highlight.Enabled = true
            else
                if highlight then highlight.Enabled = false end
            end
            
            if v.BillboardGui.Adornee ~= head then
                v.BillboardGui.Adornee = head
            end
            
            local _, OnScreen = Camera:WorldToViewportPoint(head.Position)
            if OnScreen then
                v.BillboardGui.Enabled = true
                local Distance = (Camera.CFrame.Position - hrp.Position).Magnitude
                
                v.NameTag.Text = player.Name .. " [" .. math.floor(Distance) .. "m]"
                v.NameTag.TextColor3 = _G.ColorName
                v.NameTag.Visible = _G.ESPName
                
                if _G.ESPHealth then
                    local currentHealth = math.floor(humanoid.Health)
                    local HealthPercentage = currentHealth / humanoid.MaxHealth
                    local healthColor = HealthPercentage > 0.6 and Color3.fromRGB(0, 255, 120) or (HealthPercentage > 0.3 and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(255, 50, 50))
                    
                    v.HealthTag.Text = "HP: " .. currentHealth
                    v.HealthTag.TextColor3 = healthColor
                    v.HealthTag.Visible = true
                else
                    v.HealthTag.Visible = false
                end
                continue
            end
        else
            local highlight = char and char:FindFirstChild("StaticHighlight")
            if highlight then highlight.Enabled = false end
        end
        v.BillboardGui.Enabled = false
    end

    -- REALTIME ADVANCED FOREFILL BODY SYSTEM
    if _G.ForcefieldBody and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part:IsDescendantOf(LocalPlayer.Character:FindFirstChildOfClass("Tool") or workspace) then
                part.Material = Enum.Material.ForceField
                part.Color = _G.ForcefieldColor
                part.Transparency = _G.ForcefieldTransparency
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 1
            end
        end
    end

    -- REALTIME ITEM SPIN & MATERIAL COLOR SYSTEM (NEW)
    if LocalPlayer.Character then
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            -- 1. ลอจิกการเปลี่ยนสีและวัตถุของอาวุธ (Item Effect)
            for _, itemPart in ipairs(tool:GetDescendants()) do
                if itemPart:IsA("BasePart") then
                    if _G.ItemEffectEnabled then
                        if _G.ItemMaterialType == "ForceField" then
                            itemPart.Material = Enum.Material.ForceField
                        elseif _G.ItemMaterialType == "Neon" then
                            itemPart.Material = Enum.Material.Neon
                        end
                        itemPart.Color = _G.ItemEffectColor
                    end
                end
            end

            -- 2. ลอจิกการหมุนของอาวุธที่ถือ (Item Spin)
            if _G.ItemSpinEnabled then
                itemTickCounter = itemTickCounter + (deltaTime * _G.ItemSpinSpeed)
                if _G.ItemSpinPattern == "Regular" then
                    tool.Grip = CFrame.fromEulerAnglesXYZ(0, itemTickCounter, 0)
                elseif _G.ItemSpinPattern == "Sine Wave" then
                    local sineAngle = math.sin(itemTickCounter) * math.rad(90)
                    tool.Grip = CFrame.fromEulerAnglesXYZ(0, sineAngle, 0)
                elseif _G.ItemSpinPattern == "Rapid Spin" then
                    tool.Grip = CFrame.fromEulerAnglesXYZ(itemTickCounter, itemTickCounter * 1.5, itemTickCounter * 2)
                end
            end
        end
    end
end)

